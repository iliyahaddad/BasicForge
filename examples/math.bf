Module MathDemo

    Sub Main()
        Dim a As Integer = 10
        Dim b As Integer = 20
        
        Print("a = " & a)
        Print("b = " & b)
        Print("a + b = " & (a + b))
        Print("a * b = " & (a * b))
        Print("b - a = " & (b - a))
        Print("b / a = " & (b / a))
        
        Dim result As Integer = a + b
        Print("Result: " & result)
    End Sub

End Module
